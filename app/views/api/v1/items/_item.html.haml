%tr
  %td= item.id
  %td= item.name
  %td= item.kcal
  %td= item.protein
  %td= item.fat
  %td= item.carb
  %td= item.df
  %td= item.around_qty
  %td= item.unit
  %td= item.weight
  %td= link_to '詳細', api_v1_item_path(item)
  %td= link_to '変更', edit_api_v1_item_path(item)
  %td= link_to '削除', api_v1_item_path(item), method: :delete, data: { confirm: 'よろしいですか?' }
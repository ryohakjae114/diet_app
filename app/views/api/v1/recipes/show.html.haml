%h1= @recipe.name
%table.table.table-bordered
  %thead
    %tr
      %th 写真url
      %th タンパク質
      %th 脂質(g)
      %th 炭水化物(g)
      %th 食物繊維(g)
      %th 一般料理or外食・市販
  %tbody
    %tr
      %td= @recipe.img_url
      %td= @recipe.protein
      %td= @recipe.fat
      %td= @recipe.carb
      %td= @recipe.df
      %td= @recipe.cook_at

%table.table
  %thead
    %tr
      %th アイテムID
      %th 名前
      %th カロリー
      %th 重量
      %th{:colspan => "3"}
  %tbody
    - @recipe.items.each do |item|
      %tr
        - recipe_item = @recipe.recipe_item(item)

        %td= item.id
        %td= item.name
        %td= recipe_item.kcal
        %td= recipe_item.weight
        %td= link_to 'アイテム詳細', api_v1_item_path(item)
        %td= link_to '削除', api_v1_recipe_item_path(recipe_item), method: :delete, data: { confirm: 'Are you sure?' }
%br/
= link_to 'アイテム追加', new_api_v1_recipe_item_path(@recipe)
\|
= link_to '戻る', api_v1_recipes_path
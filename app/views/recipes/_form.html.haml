= form_for @recipe do |f|
  - if @recipe.errors.any?
    #error_explanation
      %h2= "#{pluralize(@recipe.errors.count, "error")} prohibited this recipe from being saved:"
      %ul
        - @recipe.errors.full_messages.each do |message|
          %li= message

  .field
    = f.label :img_url
    = f.text_field :img_url
  .field
    = f.label :name
    = f.text_field :name
  .field
    = f.label :protein
    = f.text_field :protein
  .field
    = f.label :fat
    = f.text_field :fat
  .field
    = f.label :carb
    = f.text_field :carb
  .field
    = f.label :df
    = f.text_field :df
  .field
    = f.label :type
    = f.text_field :type
  .actions
    = f.submit 'Save'

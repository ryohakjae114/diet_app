%h1 Listing recipes

%table.table
  %thead
    %tr
      %th 名前
      %th アイテムID
      %th カロリー(kcal)
      %th グラム
      %th
      %th
      %th

  %tbody
    - @recipes.each do |recipe|
      %tr
        %td= recipe.name
        %td= recipe.item
        %td= recipe.kcal
        %td= recipe.weight
        %td= link_to 'Show', recipe
        %td= link_to 'Edit', edit_recipe_path(recipe)
        %td= link_to 'Destroy', recipe, method: :delete, data: { confirm: 'Are you sure?' }

%br

= link_to 'New Recipe', new_recipe_path

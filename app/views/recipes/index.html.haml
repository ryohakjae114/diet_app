%h1 Listing recipes

=will_paginate @items

%table
  %thead
    %tr
      %th 写真url
      %th 名前
      %th タンパク質
      %th 脂質(g)
      %th 炭水化物(g)
      %th 食物繊維(g)
      %th 種類
      %th
      %th
      %th

  %tbody
    - @recipes.each do |recipe|
      %tr
        %td= recipe.img_url
        %td= recipe.name
        %td= recipe.protein
        %td= recipe.fat
        %td= recipe.carb
        %td= recipe.df
        %td= recipe.type
        %td= link_to '詳細', recipe
        %td= link_to '変更', edit_recipe_path(recipe)
        %td= link_to '削除', recipe, method: :delete, data: { confirm: 'Are you sure?' }

%br

= link_to '新規作成', new_recipe_path
=will_paginate @items
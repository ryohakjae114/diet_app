%h1 アイテム　リスト

= render 'shared/search_item_form'

= link_to '新規作成', new_item_path

= will_paginate @items

%table.table.table-bordered
  %thead
    %tr
      %th ID
      %th アイテム名
      %th カロリー(kcal)
      %th タンパク質(g)
      %th 脂質(g)
      %th 炭水化物(g)
      %th 食物繊維(g)
      %th 分量の目安
      %th 分量単位
      %th 重量
      %th

  %tbody#items
    - @items.each do |item|
      = render item
%br
=will_paginate @items
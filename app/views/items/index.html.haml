%h1 アイテム　リスト

= form_with(url: search_items_url, method: :post, local: false) do |f|
  .text-center
    = f.text_field :keyword, placeholder: "アイテム名"
    = f.submit '検索'

= link_to '新規作成', new_item_path

= will_paginate @items

%table.table.table-bordered
  %thead
    %tr
      %th ID
      %th アイテム名
      %th カロリー(kcal)
      %th タンパク質(g)
      %th 脂質(g)
      %th 炭水化物(g)
      %th 食物繊維(g)
      %th 分量の目安
      %th 分量単位
      %th 重量
      %th

  %tbody#items
    - @items.each do |item|
      = render item
%br
=will_paginate @items
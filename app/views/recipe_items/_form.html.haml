= form_with(model: recipe_item, local: true) do |form|
  - if recipe_item.errors.any?
    #error_explanation
      %h2
        = pluralize(recipe_item.errors.count, "error")
        prohibited this recipe_item from being saved:
      %ul
        - recipe_item.errors.full_messages.each do |message|
          %li= message
  .field
    = form.label :item_id
    = form.text_field :item_id
  .field
    = form.label :weight
    = form.number_field :weight, step: 0.01
  .field
    = form.label :kcal
    = form.number_field :kcal, step: 0.01
  .actions
    = form.submit

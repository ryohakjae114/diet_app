%h1 レシピ　リスト

= link_to '新規作成', new_admins_recipe_path

=will_paginate @items

%table.table.table-bordered
  %thead
    %tr
      %th 写真url
      %th 名前
      %th タンパク質
      %th 脂質(g)
      %th 炭水化物(g)
      %th 食物繊維(g)
      %th 一般料理or外食・市販
      %th
      %th
      %th

  %tbody
    - @recipes.each do |recipe|
      %tr
        %td= recipe.img_url
        %td= recipe.name
        %td= recipe.protein
        %td= recipe.fat
        %td= recipe.carb
        %td= recipe.df
        %td= recipe.cook_at
        %td= link_to '詳細', admins_recipe_path(recipe)
        %td= link_to '変更', edit_admins_recipe_path(recipe)
        %td= link_to '削除', admins_recipe_path(recipe), method: :delete, data: { confirm: 'Are you sure?' }

%br
=will_paginate @items
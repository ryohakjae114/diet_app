%h1 アイテムを追加
= form_with(url: admins_recipe_items_path, model: @recipe_item, local: true) do |form|
  - if @recipe_item.errors.any?
    #error_explanation
      %h2
        = pluralize(@recipe_item.errors.count, "error")
        prohibited this recipe_item from being saved:
      %ul
        - @recipe_item.errors.full_messages.each do |message|
          %li= message
  .field
    = form.label :item_id
    = form.text_field :item_id
  .field
    = form.label :weight
    = form.number_field :weight, min: 0.01,step: 0.01
  .field
    = form.label :kcal
    = form.number_field :kcal,   min: 0.01, step: 0.01
  .actions
    = form.submit
= link_to 'Back', admins_recipe_path(@recipe)
%table.table
  %tbody
    %tr
    %tr
      %td
        - if @user.activated? == false
          %span.label.label-danger アカウント停止状態
        - if @user.is_suspended_diary?
          %span.label.label-danger 日記機能停止状態
    %tr
      %td
        = form_with(model: @user, url: admins_user_path(@user),local: true, class: "form-horizontal") do |f|
          = f.label :activated, 'アカウント有効', value: true, class: "radio-inline"
          = f.radio_button :activated, true, required: true, checked: "checked"
          = f.label :activated, 'アカウント無効', value: false, class: "radio-inline"
          = f.radio_button :activated, false, required: true

          = f.submit '更新'

    - if @user.diary
      %tr
        %td
          = form_with(model: @user.diary, url: admins_diary_path(@user.diary),local: true, class: "form-horizontal") do |f|
            = f.label :activated, '日記機能有効', value: true, class: "radio-inline"
            = f.radio_button :activated, true, required: true, checked: "checked"
            = f.label :activated, '日記機能無効', value: false, class: "radio-inline"
            = f.radio_button :activated, false, required: true

            = f.submit '更新'
    %tr
      %td= link_to("アカウント削除", admins_users_path(@user), method: :delete, data: { confirm: 'Are you sure?' }, class: "btn btn-danger")

%br
= link_to 'Back', admins_users_path

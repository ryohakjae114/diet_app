-breadcrumb :posts
%h1 Listing posts

%table.table.table-bordered
  %thead
    %tr
      %th ユーザID
      %th テキスト
      %th 作成日時
      %th

  %tbody
    - @posts.each do |post|
      %tr
        %td= link_to(post.user_id, edit_admins_user_path(post.user))
        %td
          - if post.text.length < 21
            = post
          - else
            = post.text[0..18] + "..."
        %td= post.created_at
        %td= link_to '詳細', admins_post_path(post)
